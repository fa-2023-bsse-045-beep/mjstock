<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MJAutos" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="android:statusBarColor">@color/app_dark_bg</item>
        <item name="android:navigationBarColor">@color/app_dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash Theme for Android 12+ and backwards compatibility -->
    <style name="Theme.MJAutos.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_dark_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.MJAutos</item>
    </style>
</resources>
