# ---------- Required ----------
# Neon connection string (Neon Console -> your project -> Connect). Use the POOLED connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign login sessions (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# First owner account - created automatically on first start if no owner exists yet.
# (You can also run: npm run create-owner)  Remove OWNER_PASSWORD from .env after the first login.
OWNER_NAME=Owner
OWNER_EMAIL=owner@mjautos.pk
OWNER_PASSWORD=ChangeThisPassword123

# ---------- Optional ----------
PORT=3000
NODE_ENV=development
# How long a login lasts (hours)
SESSION_HOURS=12
# Time zone used for "today's sales" and daily alert limits
SHOP_TIMEZONE=Asia/Karachi
# Printed on the bill header
SHOP_ADDRESS=
SHOP_PHONE=

# ---------- Optional: low-stock alerts to the owner (max once per product per day) ----------
# Email via Resend (https://resend.com)
RESEND_API_KEY=
ALERT_EMAIL_FROM=MJ AUTOS <alerts@yourdomain.com>
ALERT_EMAIL_TO=

# WhatsApp via CallMeBot (free, for personal numbers: https://www.callmebot.com/blog/free-api-whatsapp-messages/)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
